---
import '../styles/global.css';
import { site, href } from '../config';
interface Props { title?: string; description?: string; section?: 'posts' | 'about' }
const { title, description = site.description, section = 'posts' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2040%2040%22%3E%3Cpath%20d%3D%22M6%2039V17a14%2016%200%200%201%2028%200v22Z%22%20fill%3D%22%23f8f6f0%22%20stroke%3D%22%23596b50%22%2F%3E%3Ctext%20x%3D%2220%22%20y%3D%2229%22%20text-anchor%3D%22middle%22%20font-family%3D%22Georgia%2Cserif%22%20font-style%3D%22italic%22%20font-size%3D%2227%22%20fill%3D%22%23596b50%22%3EY%3C%2Ftext%3E%3C%2Fsvg%3E" />
    <meta name="theme-color" content="#f8f6f0" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={href()} aria-label={`${site.name}首页`}><span class="brand-mark" aria-hidden="true">Y</span>{site.name}</a>
        <nav aria-label="主导航">
          <a href={href()} aria-current={section === 'posts' ? 'page' : undefined}>文章</a>
          <a href={href('about/')} aria-current={section === 'about' ? 'page' : undefined}>关于</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span></footer>
    </div>
  </body>
</html>
