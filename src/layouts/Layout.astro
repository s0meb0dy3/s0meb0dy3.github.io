---
import '../styles/global.css';
import { site, href } from '../config';
import monogram from '../assets/monogram.svg?url';
interface Props { title?: string; description?: string; section?: 'posts' | 'about' }
const { title, description = site.description, section = 'posts' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="icon" type="image/svg+xml" href={monogram} />
    <meta name="theme-color" content="#f8f6f0" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={href()} aria-label={`${site.name}首页`}><img class="brand-mark" src={monogram} width="32" height="36" alt="" aria-hidden="true" />{site.name}</a>
        <nav aria-label="主导航">
          <a href={href()} aria-current={section === 'posts' ? 'page' : undefined}>文章</a>
          <a href={href('about/')} aria-current={section === 'about' ? 'page' : undefined}>关于</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span></footer>
    </div>
  </body>
</html>
