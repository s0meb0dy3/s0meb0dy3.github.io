---
import '../styles/global.css';
import { site, href } from '../config';
import monogram from '../assets/monogram.svg?url';
interface Props { title?: string; description?: string; section?: 'posts' | 'about' }
const { title, description = site.description, section = 'posts' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="icon" type="image/svg+xml" href={monogram} />
    <meta name="theme-color" content="#f2f6f7" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={href()} aria-label={`${site.name}首页`}><img class="brand-mark" src={monogram} width="32" height="36" alt="" aria-hidden="true" />{site.name}</a>
        <nav aria-label="主导航">
          <a href={href()} aria-current={section === 'posts' ? 'page' : undefined}>文章</a>
          <a href={href('about/')} aria-current={section === 'about' ? 'page' : undefined}>关于</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span></footer>
    </div>
    <svg class="waves" viewBox="0 0 2400 140" preserveAspectRatio="none" aria-hidden="true">
      <g class="wave wave-c">
        <g class="tide tide-c">
          <path d="M0 52 Q300 22 600 52 T1200 52 T1800 52 T2400 52 V140 H0Z" fill="#7fa3bb" opacity=".07"/>
          <path d="M2400 52 Q2700 22 3000 52 T3600 52 T4200 52 T4800 52 V140 H2400Z" fill="#7fa3bb" opacity=".07"/>
        </g>
      </g>
      <g class="wave wave-a">
        <g class="tide tide-a">
          <path d="M0 70 Q150 30 300 70 T600 70 T900 70 T1200 70 T1500 70 T1800 70 T2100 70 T2400 70 V140 H0Z" fill="#33688f" opacity=".10"/>
          <path d="M2400 70 Q2550 30 2700 70 T3000 70 T3300 70 T3600 70 T3900 70 T4200 70 T4500 70 T4800 70 V140 H2400Z" fill="#33688f" opacity=".10"/>
        </g>
      </g>
      <g class="wave wave-b">
        <g class="tide tide-b">
          <path d="M0 95 Q200 55 400 95 T800 95 T1200 95 T1600 95 T2000 95 T2400 95 V140 H0Z" fill="#33688f" opacity=".16"/>
          <path d="M2400 95 Q2600 55 2800 95 T3200 95 T3600 95 T4000 95 T4400 95 T4800 95 V140 H2400Z" fill="#33688f" opacity=".16"/>
        </g>
      </g>
    </svg>
  </body>
</html>
