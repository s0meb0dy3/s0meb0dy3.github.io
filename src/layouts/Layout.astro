---
import '../styles/global.css';
import { site, href } from '../config';
interface Props { title?: string; description?: string; section?: 'posts' | 'about' }
const { title, description = site.description, section = 'posts' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 40 40%27%3E%3Crect width=%2740%27 height=%2740%27 rx=%274%27 fill=%27%2352684c%27/%3E%3Ctext x=%2720%27 y=%2728%27 text-anchor=%27middle%27 font-size=%2726%27 fill=%27%23f7f6f0%27%3EY%3C/text%3E%3C/svg%3E" />
    <meta name="theme-color" content="#f7f6f0" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={href()} aria-label={`${site.name}首页`}><span class="brand-mark" aria-hidden="true">Y</span>{site.name}</a>
        <nav aria-label="主导航">
          <a href={href()} aria-current={section === 'posts' ? 'page' : undefined}>文章</a>
          <a href={href('about/')} aria-current={section === 'about' ? 'page' : undefined}>关于</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span></footer>
    </div>
  </body>
</html>
